<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tests of HostDossier.Core: reading names and networks, SPF against a made-up DNS, the TLS hello and replies
       byte by byte, and the rest of what can be judged from known input. They need no network: TlsScanner and PortScanner
       are run against servers started here on the loopback address. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Strongthium.HostDossier.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HostDossier.Core\HostDossier.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
