<Project Sdk="Microsoft.NET.Sdk">
  <!-- host-dossier on the command line: the same lookup as the window, for scripts and for servers, on Windows and Linux. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>host-dossier-cli</AssemblyName>
    <RootNamespace>Strongthium.HostDossier.Cli</RootNamespace>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <!-- The runtime isn't inside it: the .NET 10 Runtime on the computer runs it. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- A release is the one program: no debug symbols beside it. -->
  <Target Name="LeaveOut" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\HostDossier.Core\HostDossier.Core.csproj" />
  </ItemGroup>
</Project>
